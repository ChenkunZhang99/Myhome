{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-stock-planner",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],

  // 走 workers.dev 的免费子域。写在配置里而不是在面板上点开，
  // 这样重新部署不会把它丢掉，换台机器部署也是同样的结果。
  "workers_dev": true,

  // 关掉每个版本各自的预览地址。它们和正式地址共用同一个 D1，
  // 等于把同一份数据多开几个永久入口——个人项目用不到 PR 预览这类场景，
  // 白送的攻击面不要也罢。
  "preview_urls": false,

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },

  // 本地开发用 Miniflare 模拟，不需要真实的 Cloudflare 账号，
  // 下面这个占位 id 在本地不会被用到。
  // 部署步骤见 docs/deploy.md。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-stock-planner",
      "database_id": "eccc102e-b921-40da-8cd4-03eb5b52e2f8"
    }
  ],

  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "home-stock-uploads"
    }
  ],

  /**
   * 线上默认值。
   *
   * 这两个开关写在提交进版本库的配置里，而不是留成部署时的手工步骤——
   * 忘记设 REQUIRE_HOUSEHOLD 的后果是任何人都能读到这个家的全部库存，
   * 那种错误不该靠记性来防。
   *
   * 本地开发用 .dev.vars 覆盖它们，那个文件优先级更高。
   */
  "vars": {
    "REQUIRE_HOUSEHOLD": "on",
    "DEMO_MODE": "off"
  },

  // 每 6 小时检查一次是否到了 flyer 自动同步时间。
  "triggers": {
    "crons": ["0 */6 * * *"]
  }

  // 可选：开通 Cloudflare Images 后取消注释，图片会走尺寸优化；
  // 不配置时应用会直接返回原图，功能不受影响。
  // "images": { "binding": "IMAGES" }
}
