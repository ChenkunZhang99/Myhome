OPENAI_API_KEY=
OPENAI_MODEL=
DEMO_MODE=

# 设为 on 后必须登录才能访问，公开部署时打开
REQUIRE_HOUSEHOLD=
# 配置后登录链接改为真实发信，留空则打印到控制台
RESEND_API_KEY=
LOGIN_FROM_EMAIL=

# 密码哈希轮数，默认 20000（约 2ms CPU），为了能跑在 Workers 免费版的
# 10ms CPU 上限内。迁到付费版（单请求 30 秒）后调到 600000，
# 那是 OWASP 的建议值。已存在的密码不受影响，哈希串自带轮数。
PASSWORD_ITERATIONS=

# 对所有人开放注册。关掉就只有「已有账号 / 第一个人 / 拿着邀请的人」进得来。
OPEN_SIGNUP=on
